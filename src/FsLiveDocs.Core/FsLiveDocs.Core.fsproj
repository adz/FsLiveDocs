<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>FsLiveDocs.Core</PackageId>
    <Version>0.1.0</Version>
    <Authors>FsLiveDocs contributors</Authors>
    <Description>Runtime attribute and models for FsLiveDocs documentation examples.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/fsprojects/FsLiveDocs</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Transcript.fs" />
    <Compile Include="Models.fs" />
    <Compile Include="History.fs" />
    <Compile Include="SourceParameters.fs" />
    <Compile Include="SymbolLister.fs" />
    <Compile Include="DocumentationDiscovery.fs" />
    <Compile Include="SemanticCode.fs" />
    <Compile Include="ContentProvider.fs" />
    <Compile Include="Library.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../FsLiveDocs.Abstractions/FsLiveDocs.Abstractions.csproj" />
    <PackageReference Include="FSharp.Compiler.Service" Version="43.12.201" />
    <PackageReference Include="FSharp.Formatting" Version="22.0.0" />
    <PackageReference Include="Markdig" Version="1.2.0" />
    <PackageReference Include="YamlDotNet" Version="17.1.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

</Project>
