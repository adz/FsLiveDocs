<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>FsLiveDocs.Core</PackageId>
    <Title>FsLiveDocs Core</Title>
    <Description>Core models, documentation discovery, semantic extraction, and release capsules for FsLiveDocs.</Description>
    <PackageTags>fsharp;documentation;doctest;api-docs</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Transcript.fs" />
    <Compile Include="DocumentationModel.fs" />
    <Compile Include="ApiModel.fs" />
    <Compile Include="ApiDiagnostic.fs" />
    <Compile Include="SemanticModel.fs" />
    <Compile Include="HistoryModel.fs" />
    <Compile Include="RunnerModel.fs" />
    <Compile Include="SiteModel.fs" />
    <Compile Include="ReleaseModel.fs" />
    <Compile Include="Serialization.fs" />
    <Compile Include="History.fs" />
    <Compile Include="ReleaseCapsule.fs" />
    <Compile Include="SourceParameters.fs" />
    <Compile Include="SymbolLister.fs" />
    <Compile Include="DocumentationDiscovery.fs" />
    <Compile Include="SemanticCode.fs" />
    <Compile Include="ContentProvider.fs" />
    <Compile Include="Library.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../FsLiveDocs.Annotations/FsLiveDocs.Annotations.csproj" />
    <PackageReference Include="FSharp.Compiler.Service" Version="43.12.201" />
    <PackageReference Include="FSharp.Formatting" Version="22.0.0" />
    <PackageReference Include="Markdig" Version="1.2.0" />
    <PackageReference Include="YamlDotNet" Version="17.1.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

</Project>
