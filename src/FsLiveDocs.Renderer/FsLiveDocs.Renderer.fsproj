<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>FsLiveDocs.Renderer</PackageId>
    <Title>FsLiveDocs Renderer</Title>
    <Description>Static-site renderer for current and historical FsLiveDocs artifacts.</Description>
    <PackageTags>fsharp;documentation;api-docs;static-site-generator</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Presentation.fs" />
    <Compile Include="View.fs" />
    <Compile Include="SiteBuilder.fs" />
    <Compile Include="Library.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FsLiveDocs.Core\FsLiveDocs.Core.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Giraffe.ViewEngine" Version="1.4.0" />
    <PackageReference Include="Markdig" Version="1.2.0" />
  </ItemGroup>

</Project>
