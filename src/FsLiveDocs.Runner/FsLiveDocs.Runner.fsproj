<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>FsLiveDocs.Runner</PackageId>
    <Title>FsLiveDocs Runner</Title>
    <Description>Compilation and execution engine for verified FsLiveDocs examples.</Description>
    <PackageTags>fsharp;documentation;doctest;testing</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="ProjectResolver.fs" />
    <Compile Include="CheckerPool.fs" />
    <Compile Include="MsBuild.fs" />
    <Compile Include="DocumentationCompiler.fs" />
    <Compile Include="SemanticExtractor.fs" />
    <Compile Include="TranscriptHostClient.fs" />
    <Compile Include="FsiTranscriptRunner.fs" />
    <Compile Include="GeneratedVerification.fs" />
    <Compile Include="DocTestRunner.fs" />
    <Compile Include="Library.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FsLiveDocs.Core\FsLiveDocs.Core.fsproj" />
    <!-- The worker is referenced for its protocol types and so it is copied beside this assembly in every consumer's
         output. It must stay free of FsLiveDocs.Core and Axial; the reference only ever points this way. -->
    <ProjectReference Include="..\FsLiveDocs.TranscriptHost\FsLiveDocs.TranscriptHost.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FSharp.Compiler.Service" Version="43.12.201" />
    <!-- Axial/Axial.Process/Axial.Console/Axial.FileSystem/Axial.PlatformService come transitively
         from FsLiveDocs.Core, which owns the shared FsLiveDocs.Core.Effects module. Axial.Layers
         is the one Axial package genuinely local to this project (CheckerPool.fs's pool). -->
    <PackageReference Include="Axial.Layers" Version="0.9.1" />
  </ItemGroup>

</Project>
