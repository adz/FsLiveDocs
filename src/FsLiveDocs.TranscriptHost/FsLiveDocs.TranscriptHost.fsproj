<Project Sdk="Microsoft.NET.Sdk">

  <!-- The transcript worker. It must never reference FsLiveDocs.Core, FsLiveDocs.Runner, Axial, or any other library
       a documented project might also use: the worker process exists so that the documented project's dependency
       graph is loaded without the tool's. See dev-docs/VERIFICATION_ARCHITECTURE.md. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <!-- The worker is launched with `dotnet exec`; a platform-specific apphost would only bloat the any-RID tool package. -->
    <UseAppHost>false</UseAppHost>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Protocol.fs" />
    <Compile Include="Evaluation.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FSharp.Compiler.Service" Version="43.12.201" />
  </ItemGroup>

</Project>
